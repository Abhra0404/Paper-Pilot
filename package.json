{
  "name": "paperpilot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5174 --strictPort\" \"cd ai-service && python3 -m uvicorn main:app --host 127.0.0.1 --port 8000\" \"wait-on http://localhost:5174 http://localhost:8000 && VITE_DEV_SERVER_URL=http://localhost:5174 electron electron/main.js\"",
    "dev:ai-service": "cd ai-service && python3 -m uvicorn main:app --host 127.0.0.1 --port 8000",
    "build": "vite build",
    "package": "npm run build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron electron/main.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "concurrently": "^10.0.5",
    "katex": "^0.19.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wait-on": "^9.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.paperpilot.app",
    "productName": "PaperPilot",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "ai-service/**/*",
      "assets/icons/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "ai-service/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "assets/icons/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icons/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
